HF_TOKEN=
SSL_VERIFY=false
EMBED_MODE=local
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=32
LOCAL_EMBED_BATCH_SIZE=32
HF_REQUEST_DELAY=0.12
HF_BATCH_DELAY=0.5
SESSION_EXERCISE_COUNT=6
MAX_TOTAL_EXERCISES=20

# Workout planning.
# When the user gives no number, this many exercises are split across the muscle groups.
DAILY_EXERCISE_TOTAL=15
# Upper bound when the user asks for an explicit number (e.g. "20 shoulder exercises").
MAX_EXERCISES_PER_GROUP=30

# LLM agent. Set USE_LLM_AGENT=false to disable entirely.
USE_LLM_AGENT=true

# Provider: "gemini" (cloud) or "ollama" (local).
AGENT_PROVIDER=gemini

# Gemini (cloud). Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AGENT_MODEL=gemini-2.5-flash

# Ollama (local). Used when AGENT_PROVIDER=ollama. Model must support tools (e.g. mistral).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TOOL_ROUNDS=1

# Logging: DEBUG, INFO, WARNING, ERROR (default INFO). Output: logs/trainer.txt
LOG_LEVEL=INFO
